# Credenciais dos bancos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT compartilhado entre o gateway e os microsservicos (minimo 32 caracteres)
JWT_SECRET=dev-secret-key-with-at-least-32-characters-change-me
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=user-service

# UID/GID do usuario local (usado pelo modo dev em docker-compose.dev.yml)
UID=1000
GID=1000

# Portas expostas no host
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
TASK_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083

USER_DB_PORT=5433
TASK_DB_PORT=5434
NOTIFICATION_DB_PORT=5435

JWT_SECRETE=openssl rand -base64 32